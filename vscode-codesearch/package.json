{
  "name": "codesearch",
  "publisher": "local",
  "displayName": "TsCodeSearch",
  "description": "Full-text and structural code search backed by a local Tantivy index",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/tscodesearch.git",
    "directory": "vscode-codesearch"
  },
  "homepage": "https://github.com/microsoft/tscodesearch#readme",
  "bugs": {
    "url": "https://github.com/microsoft/tscodesearch/issues"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TsCodeSearch starts local repository scripts and reads local configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "TsCodeSearch requires local filesystem paths and a local daemon."
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "code search",
    "mcp",
    "tantivy",
    "tree-sitter"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tscodesearch",
          "title": "TsCodeSearch",
          "icon": "icons/codesearch.svg"
        }
      ]
    },
    "views": {
      "tscodesearch": [
        {
          "type": "webview",
          "id": "tscodesearch.panel",
          "name": "Search"
        },
        {
          "id": "tscodesearch.roots",
          "name": "Roots",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "tscodesearch.openPanel",
        "title": "TsCodeSearch: Open Panel",
        "icon": "$(search)"
      },
      {
        "command": "tscodesearch.setup",
        "title": "TsCodeSearch: Set Up",
        "icon": "$(rocket)"
      },
      {
        "command": "tscodesearch.addRoot",
        "title": "TsCodeSearch: Add Root",
        "icon": "$(add)"
      },
      {
        "command": "tscodesearch.removeRoot",
        "title": "TsCodeSearch: Remove Root",
        "icon": "$(remove)"
      },
      {
        "command": "tscodesearch.restartDaemon",
        "title": "TsCodeSearch: Restart",
        "icon": "$(debug-restart)"
      },
      {
        "command": "tscodesearch.stopDaemon",
        "title": "TsCodeSearch: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tscodesearch.reindex",
        "title": "TsCodeSearch: Re-index Root",
        "icon": "$(sync)"
      },
      {
        "command": "tscodesearch.refreshRoots",
        "title": "TsCodeSearch: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": [
      {
        "title": "TsCodeSearch",
        "properties": {
          "tscodesearch.repoPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "Path to the tscodesearch repository root. Optional -- auto-detected from workspace folders."
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "tscodesearch.openPanel",
        "key": "ctrl+shift+f1",
        "mac": "cmd+shift+f1"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tscodesearch.openPanel"
        },
        {
          "command": "tscodesearch.setup"
        },
        {
          "command": "tscodesearch.addRoot"
        },
        {
          "command": "tscodesearch.removeRoot"
        },
        {
          "command": "tscodesearch.restartDaemon"
        },
        {
          "command": "tscodesearch.stopDaemon"
        },
        {
          "command": "tscodesearch.refreshRoots"
        }
      ],
      "view/title": [
        {
          "command": "tscodesearch.addRoot",
          "when": "view == tscodesearch.roots",
          "group": "navigation"
        },
        {
          "command": "tscodesearch.refreshRoots",
          "when": "view == tscodesearch.roots",
          "group": "navigation"
        },
        {
          "command": "tscodesearch.restartDaemon",
          "when": "view == tscodesearch.roots",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tscodesearch.removeRoot",
          "when": "view == tscodesearch.roots && viewItem == root",
          "group": "inline"
        },
        {
          "command": "tscodesearch.reindex",
          "when": "view == tscodesearch.roots && viewItem == root",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "prebuild": "node -e \"var d=new Date();require('fs').writeFileSync('src/buildInfo.ts','export const BUILD_DATE = \\\"'+d.toISOString().slice(0,16).replace('T',' ')+' UTC\\\";\\n')\"",
    "precompile": "npm run clean && npm run prebuild",
    "prewatch": "npm run prebuild",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --require tsx/cjs --test src/test/client.test.ts src/test/webview.test.ts src/test/pipeline.test.ts",
    "test:pipeline": "node --require tsx/cjs --test src/test/pipeline.test.ts",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "^4.1.5",
    "qs": "^6.16.0"
  }
}
