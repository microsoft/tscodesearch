{
  "servers": {
    "tscodesearch": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--project",
        "${workspaceFolder}/..",
        "--directory",
        "${workspaceFolder}/..",
        "python",
        "${workspaceFolder}/../mcp_server.py"
      ],
      "cwd": "${workspaceFolder}/..",
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/../.venv"
      }
    }
  }
}
